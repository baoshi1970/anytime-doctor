# PostgreSQL connection details (used by database.py if not overridden by environment variables)
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_SERVER=db # This should match the service name in docker-compose.yml
POSTGRES_PORT=5432
POSTGRES_DB=appdb

# Uvicorn server details (can be used in Dockerfile or docker-compose.yml)
# HOST=0.0.0.0

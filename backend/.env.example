# PostgreSQL connection details
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_DB=appdb

# Uvicorn server details
# HOST=0.0.0.0
# PORT=8000

# JWT Settings
# Generate a strong secret key using: python -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY="your-secret-key-for-jwt-shhh-please-replace-me"
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7 # If using refresh tokens
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=15 # For password reset links
